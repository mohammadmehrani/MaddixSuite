# MaddixSuite .gitignore

# OS artifacts
*.log
*.old
*.bak
*.swp
*.swo
*~

# Desktop output directory
Desktop/MaddixSuite/

# Test coverage output
coverage/
htmlcov/

# IDE
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Python (for future web tools)
__pycache__/
*.py[cod]
*$py.class
*.so
.env
venv/
.venv/

# Node (for future web tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# GitHub Pages / docs output
_site/
site/

# Working directory
*.tmp
